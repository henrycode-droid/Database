{
    "name": "vendor/project",
    "description": "intl students database project",
    "type": "project",
    "license": "",
    "authors": [
        {
            "name": "Henry Agyapong",
            "email": "henryagyapong7@gmail.com"
        }
    ],
    "require": {
        "ext-pdo_mysql": "*",
        "ext-mysqli": "*",
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": ["@php -r \"echo 'Installation complete!\\n';\""]
    },
    "config": {
        "sort-packages": true
    }
}   
